rules_version = '2';
// Complete proposed rules. Review/test locally; never deployed by this task.
// Baseline: the latest pasted rules plus the collection operations in this repo.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function currentAccount() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasActiveRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentAccount().get('role', '') == role
        && currentAccount().get('status', 'active') == 'active';
    }
    function isAdmin() {
      return hasActiveRole('admin');
    }
    function isDonor() { return hasActiveRole('donor'); }
    function isRequester() { return hasActiveRole('requester'); }
    function isHealthcare() {
      return hasActiveRole('healthcare')
        && currentAccount().get('approvalStatus', 'pending') == 'approved';
    }
    function isBloodBank() {
      return hasActiveRole('bloodBank')
        && currentAccount().get('approvalStatus', 'pending') == 'approved';
    }
    function validStaffRegistration(data) {
      return data.approvalStatus == 'pending'
        && data.institutionName is string && data.institutionName.size() >= 2 && data.institutionName.size() <= 150
        && data.designation is string && data.designation.size() >= 2 && data.designation.size() <= 100
        && data.employeeId is string && data.employeeId.size() > 0 && data.employeeId.size() <= 50;
    }
    function validAdminDecision(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin() && userId != request.auth.uid
        && resource.data.role in ['healthcare', 'bloodBank']
        && resource.data.get('approvalStatus', 'pending') == 'pending'
        && request.resource.data.uid == resource.data.uid
        && resource.data.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.get('approvalStatus', 'pending') == 'approved'
            && changed.hasOnly(['approvalStatus', 'approvedAt', 'approvedBy', 'updatedAt'])
            && request.resource.data.approvedAt == request.time
            && request.resource.data.approvedBy == request.auth.uid
            && !request.resource.data.keys().hasAny(['rejectedAt', 'rejectedBy']))
          || (request.resource.data.get('approvalStatus', 'pending') == 'rejected'
            && changed.hasOnly(['approvalStatus', 'rejectedAt', 'rejectedBy', 'updatedAt'])
            && request.resource.data.rejectedAt == request.time
            && request.resource.data.rejectedBy == request.auth.uid
            && !request.resource.data.keys().hasAny(['approvedAt', 'approvedBy']))
        );
    }
    function ordinaryProfileUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let editable = ['fullName', 'email', 'phone', 'photoURL', 'lastLoginAt', 'updatedAt'];
      return (isOwner(userId) || isAdmin())
        && resource.data.uid == userId
        // An empty diff passes hasOnly(). Require a real editable-field change too,
        // so deleting an absent protected field cannot authorize a no-op write.
        && changed.hasOnly(editable)
        && changed.hasAny(editable);
    }
    function adminStatusUpdate(userId) {
      return isAdmin() && userId != request.auth.uid
        && resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['active', 'suspended']
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'email', 'phone', 'role', 'healthcareType', 'status', 'photoURL',
          'approvalStatus', 'institutionName', 'designation', 'employeeId',
          'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.role in ['donor', 'requester', 'healthcare', 'bloodBank']
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.keys().hasAny(['approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy'])
        && (
          (request.resource.data.role in ['healthcare', 'bloodBank'] && validStaffRegistration(request.resource.data))
          || (request.resource.data.role in ['donor', 'requester'] && !request.resource.data.keys().hasAny(['approvalStatus']))
        );
      // No ordinary branch can change roles, approval or application/audit fields.
      allow update: if validAdminDecision(userId) || ordinaryProfileUpdate(userId) || adminStatusUpdate(userId);
      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    // Existing donor permissions are retained; healthcare access now requires approval.
    match /donorProfiles/{userId} {
      allow read: if (isDonor() && isOwner(userId)) || isHealthcare() || isAdmin();
      allow create: if isDonor() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isDonor() && isOwner(userId) && resource.data.userId == userId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin();
    }
    match /donorResponses/{responseId} {
      // GET must work before the donor's deterministic response document exists.
      allow get: if (isDonor() && responseId.matches('.*_' + request.auth.uid + '$')
        && (!exists(/databases/$(database)/documents/donorResponses/$(responseId))
          || resource.data.donorId == request.auth.uid)) || isHealthcare() || isAdmin();
      // Healthcare queries accepted/completed responses for the dashboard summary.
      allow list: if (isDonor() && resource.data.donorId == request.auth.uid) || isHealthcare() || isAdmin();
      allow create: if isDonor() && request.resource.data.donorId == request.auth.uid
        && request.resource.data.requestId is string
        && responseId == request.resource.data.requestId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['donorId', 'requestId', 'response', 'status', 'requestSnapshot', 'createdAt', 'updatedAt'])
        && request.resource.data.response in ['accepted', 'declined']
        && request.resource.data.status == request.resource.data.response
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isDonor() && resource.data.donorId == request.auth.uid
        && request.resource.data.donorId == resource.data.donorId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response', 'status', 'requestSnapshot', 'updatedAt'])
        && request.resource.data.response in ['accepted', 'declined']
        && request.resource.data.status in ['accepted', 'declined', 'pending', 'completed', 'withdrawn']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isDonor() && resource.data.donorId == request.auth.uid
        && resource.data.status in ['declined', 'withdrawn'];
    }

    function validBloodDetails(data) {
      return data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
        && data.unitsRequired is int && data.unitsRequired > 0
        && data.hospitalName is string && data.hospitalName.size() > 0
        && data.location is string && data.location.size() > 0
        && data.requiredDate is string && data.requiredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.urgency in ['normal', 'urgent', 'critical'];
    }
    function canReadAllRequests() { return isDonor() || isAdmin() || isHealthcare() || isBloodBank(); }
    match /emergencyRequests/{requestId} {
      // Creation transaction reads its new ID before writing it. Preserve that GET.
      allow get: if canReadAllRequests() || (isRequester()
        && (!exists(/databases/$(database)/documents/emergencyRequests/$(requestId))
          || resource.data.requesterId == request.auth.uid));
      // Requester history must query where('requesterId', '==', currentUser.uid).
      allow list: if canReadAllRequests() || (isRequester() && resource.data.requesterId == request.auth.uid);
      allow create: if isRequester() && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.verified == false
        && request.resource.data.get('isVerified', false) == false
        && !request.resource.data.keys().hasAny(['cancelledAt', 'cancelledBy'])
        && validBloodDetails(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      // Existing requester update workflow retained.
      allow update: if isRequester() && resource.data.requesterId == request.auth.uid
        && resource.data.status in ['pending_verification', 'pending', 'open']
        && resource.data.get('verified', false) == false && resource.data.get('isVerified', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'unitsRequired', 'hospitalName', 'location', 'requiredDate', 'urgency', 'updatedAt'
        ])
        && request.resource.data.unitsRequired is int && request.resource.data.unitsRequired > 0
        && request.resource.data.hospitalName is string && request.resource.data.hospitalName.size() > 0
        && request.resource.data.location is string && request.resource.data.location.size() > 0
        && request.resource.data.requiredDate is string && request.resource.data.requiredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.urgency in ['normal', 'urgent', 'critical']
        && request.resource.data.updatedAt == request.time;
      // Existing verification workflow retained, with approved healthcare role required.
      allow update: if isHealthcare()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'status', 'updatedAt'])
        && request.resource.data.verified is bool && request.resource.data.status in ['verified', 'rejected']
        && request.resource.data.updatedAt == request.time;
      // Preserve the requester service's soft-cancel operation; no document deletion.
      allow update: if isRequester() && resource.data.requesterId == request.auth.uid
        && resource.data.status in ['pending_verification', 'pending', 'open', 'verified', 'approved',
          'matching', 'donor_matching', 'matched', 'donor_found']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'cancelledAt', 'updatedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelledAt == request.time && request.resource.data.updatedAt == request.time;
    }

    // Existing match permissions retained. No additional admin access is granted.
    match /donorMatches/{matchId} {
      allow read: if isHealthcare();
      allow create: if isHealthcare()
        && request.resource.data.keys().hasOnly(['requestId', 'donorId', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.requestId is string && request.resource.data.donorId is string
        && matchId == request.resource.data.requestId + '_' + request.resource.data.donorId
        && request.resource.data.status == 'matched'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }
    function matchMessageMatchExists(matchId) {
      let matchPath = /databases/$(database)/documents/donorMatches/$(matchId);
      let matchData = get(matchPath).data;
      return exists(matchPath) && matchData.requestId is string && matchData.donorId is string
        && matchData.status == 'matched' && matchId == matchData.requestId + '_' + matchData.donorId;
    }
    function canAccessMatchMessages(matchId) {
      let matchPath = /databases/$(database)/documents/donorMatches/$(matchId);
      return signedIn() && matchMessageMatchExists(matchId)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (isHealthcare() || (isDonor() && get(matchPath).data.donorId == request.auth.uid));
    }
    match /donorMatches/{matchId}/messages/{messageId} {
      allow read: if canAccessMatchMessages(matchId);
      allow create: if canAccessMatchMessages(matchId)
        && request.resource.data.keys().hasAll(['senderId', 'senderRole', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['senderId', 'senderRole', 'text', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == currentAccount().role
        && request.resource.data.senderRole in ['healthcare', 'donor']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /bloodInventory/{inventoryId} {
      allow read, delete: if isAdmin() || isBloodBank();
      allow create, update: if (isAdmin() || isBloodBank())
        && request.resource.data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
        && request.resource.data.availableUnits is int && request.resource.data.availableUnits >= 0
        && request.resource.data.status in ['Normal', 'Low Stock'];
    }
    function validDonationCentre(data) {
      return data.keys().hasAll(['name', 'address', 'district', 'phone', 'latitude', 'longitude', 'isActive'])
        && data.keys().hasOnly(['name', 'address', 'district', 'phone', 'latitude', 'longitude', 'isActive', 'openingHours'])
        && (!('openingHours' in data) || (data.openingHours is string && data.openingHours.size() <= 500))
        && data.name is string && data.name.size() <= 150 && data.name.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && data.address is string && data.address.size() <= 500 && data.address.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && data.district is string && data.district.size() <= 150 && data.district.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && data.phone is string && data.phone.size() <= 40
        && data.phone.matches('\\+?([ ().-]*[0-9]){6,15}[ ().-]*')
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.isActive is bool;
    }
    match /donationCentres/{centreId} {
      allow read: if isAdmin() || (isDonor() && resource.data.isActive == true);
      allow create: if isAdmin() && validDonationCentre(request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'address', 'district', 'phone', 'latitude', 'longitude', 'isActive', 'openingHours'])
        && validDonationCentre(request.resource.data);
      allow delete: if false;
    }
  }
}
